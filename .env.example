# Chave da API Anthropic. Sem ela o servico opera apenas com o diagnostico por regras (fallback).
ANTHROPIC_API_KEY=

# Modelo usado no diagnostico estruturado.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Timeout por chamada (segundos) e numero de retentativas do SDK em 429/5xx/timeout.
LLM_TIMEOUT_SEGUNDOS=15
LLM_MAX_RETRIES=1

# Artefato do modelo preditivo e limiar de risco que aciona o LLM (0 a 1).
MODEL_PATH=models/predictive_model.joblib
LIMIAR_ALERTA=0.80

LOG_LEVEL=INFO
